{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lifespan-sleep-education-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "GROQ_MODEL": "llama-3.3-70b-versatile",
    "EVIDENCE_BANK_ENABLED": "false",
    "EVIDENCE_BANK_VERSION": "",
    "ALLOWED_ORIGINS": "http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006,http://localhost:19007,http://127.0.0.1:19007,http://localhost:19008,http://127.0.0.1:19008"
  }
}
