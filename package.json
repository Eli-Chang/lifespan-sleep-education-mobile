{
  "name": "lifespan-sleep-education-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "node scripts/dev-web-preview.mjs",
    "dev:canonical": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/dev-canonical.ps1",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "validate:content": "tsx scripts/validate-content.ts",
    "verify:agents": "node scripts/verify-agent-orchestration.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "evaluation:validate": "python evaluation/scripts/validate-evaluation.py",
    "evaluation:fixtures": "python evaluation/scripts/fixture_validation.py",
    "evaluation:knowledge": "tsx evaluation/scripts/validate-knowledge-bank.ts",
    "evaluation:ui": "python evaluation/scripts/run-ui-evaluation.py",
    "evaluation:ui:headed": "python evaluation/scripts/run-ui-evaluation.py --headed",
    "evaluation:ui:update": "python evaluation/scripts/run-ui-evaluation.py --update",
    "evaluation:ui:report": "python evaluation/scripts/evaluation-command.py ui-report",
    "evaluation:ai:fixture": "python evaluation/scripts/run-ai-evaluation.py --mode fixture --run-type adhoc",
    "evaluation:ai:live": "python evaluation/scripts/run-ai-evaluation.py --mode live --run-type adhoc",
    "evaluation:db": "python evaluation/scripts/evaluation-command.py db",
    "evaluation:dashboard": "python evaluation/scripts/evaluation-command.py dashboard",
    "evaluation:report": "python evaluation/scripts/evaluation-command.py report",
    "evaluation:compare": "python evaluation/scripts/evaluation-command.py compare",
    "evaluation:all": "python evaluation/scripts/run-all.py",
    "evaluation:sheets": "python evaluation/scripts/evaluation-command.py sheets",
    "evaluation:live:preflight": "python evaluation/scripts/live-groq-preflight.py",
    "evaluation:live:test": "python -m unittest discover -s evaluation/tests -p test_*.py",
    "evaluation:live:run": "python evaluation/scripts/run-live-evaluation.py",
    "evaluation:live:canaries": "python evaluation/scripts/run-live-canaries.py",
    "evaluation:live:playwright": "python evaluation/scripts/run-live-playwright.py",
    "evaluation:live:validate": "python evaluation/scripts/validate-live-run.py",
    "evaluation:live:db": "python evaluation/scripts/live-artifacts.py db",
    "evaluation:live:dashboard": "python evaluation/scripts/live-artifacts.py dashboard",
    "evaluation:live:report": "python evaluation/scripts/live-artifacts.py report",
    "evaluation:live:compare": "python evaluation/scripts/live-artifacts.py compare"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.37",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-dev-client": "6.0.21",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "i18next": "^26.3.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.11",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.2"
  },
  "private": true,
  "description": "A patient-facing Expo React Native education app about obstructive sleep apnea, pregnancy, PAP therapy, sleep health, relationships, and intimacy. It contains seven screenshot-traceable modules in English and Spanish, offline written content, local progress, interactive questions, and device text-to-speech.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RangerX042/lifespan-sleep-education-mobile.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/RangerX042/lifespan-sleep-education-mobile/issues"
  },
  "homepage": "https://github.com/RangerX042/lifespan-sleep-education-mobile#readme"
}
